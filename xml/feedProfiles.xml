        </ration>
        <milk realKgPerDay="2.1" meMJPerKg="8.3"/>
        <damMilk dm="0.19" me="25.0" cp="0.28"/>
        <nursing weaningMonth="3" earlyWeaningMonth="2" readyCreepKgPerDay="0.25" readyDays="3.5"
